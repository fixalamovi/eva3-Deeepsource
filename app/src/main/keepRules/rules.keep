# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
# Los DTO de Firebase se leen y escriben mediante reflexión de Gson.
-keep class com.example.deepsource.data.model.GoogleSignInRequest { *; }
-keep class com.example.deepsource.data.model.GoogleSignInResponse { *; }
-keep class com.example.deepsource.data.remote.** { *; }
-keep class com.example.deepsource.domain.Session { *; }
-keep class com.example.deepsource.domain.Project { *; }
-keep class com.example.deepsource.domain.ProjectTask { *; }
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}
